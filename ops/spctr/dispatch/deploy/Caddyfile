{
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

specterlab.org, www.specterlab.org {
    handle /data/* {
        root * /srv/www/site
        encode zstd gzip
        file_server
    }
    @index_html path_regexp index_html ^(.*/)index\.html$
    redir @index_html {re.index_html.1} 301
    @zang_levin path_regexp zang_levin ^/(dossiers|cabinet)/zang-levin-playground(/.*)?$
    redir @zang_levin /{re.zang_levin.1}/zhang-levin-playground{re.zang_levin.2} 301
    root * /srv/www/site/current
    encode zstd gzip
    file_server
    handle_errors {
        @notfound expression {err.status_code} == 404
        handle @notfound {
            root * /srv/www/site/current
            rewrite * /404.html
            file_server
        }
    }
}

dispatch.specterlab.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3001
}

releases.specterlab.org {
    root * /srv/www/releases
    encode zstd gzip
    @withdrawn path /site /site/* /lenia-swarm/causal-emergence /lenia-swarm/causal-emergence/*
    respond @withdrawn 404
    file_server browse
}

lab.specterlab.org {
    tls /etc/caddy/certs/lab.specterlab.org.pem /etc/caddy/certs/lab.specterlab.org.key
    encode zstd gzip
    @push path /api/push/*
    request_body @push {
        max_size 100MB
    }
    @interactive not path /api/push/*
    request_body @interactive {
        max_size 40KB
    }
    reverse_proxy 127.0.0.1:8921
}

review.specterlab.org {
    tls /etc/caddy/certs/review.specterlab.org.pem /etc/caddy/certs/review.specterlab.org.key
    encode zstd gzip
    request_body {
        max_size 40KB
    }
    reverse_proxy 127.0.0.1:8921
}
